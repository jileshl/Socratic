# OpenRouter API Key (required for LLM calls)
# Get your key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Optional model overrides (defaults shown)
# TOOL_MODEL=openai/gpt-4o-mini
# FAST_MODEL=meta-llama/llama-3.1-8b-instruct
## RUBICS_MODEL=
TEMPERATURE=0.0
# MAX_TOKENS=900

# Optional local paths (relative paths are resolved from the repository root)
DATA_DIR=./data
DOCUMENT_PATH=./data

# Optional retrieval configuration (dense / hybrid / hybrid_rerank)
# RETRIEVAL_MODE=dense
# TOP_K=4
# CANDIDATE_K=8

# Optional policy & runtime controls
# AGENT_REFUND_LIMIT_INR=5000
# MAX_TOOL_STEPS=6
# LLM_CACHE=true

# Web app and operations (R6)
TEACHER_PIN=1234            # change before any demo; the teacher view needs it
# OPS_DEMO=1                # enables the synthetic leak button used to demo the AnswerLeakSpike alert
# LANGSMITH_TRACING=true    # optional: also send traces to LangSmith (scrubbed traces are always in .cache/traces/)
# LANGSMITH_API_KEY=

# Evaluation (R5): model IDs and budgets are in socratic_tutor/config.py; these override one value
# SIMULATED_STUDENT_MODEL=meta-llama/llama-3.3-70b-instruct
# EVAL_STUB=1               # run the eval harness with the offline stand-in (plumbing check only)
