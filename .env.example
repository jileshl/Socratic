# OpenRouter API Key (required for LLM calls)
# Get your key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-v1-...
# OPENAI_API_KEY=                 # used only when OPENROUTER_API_KEY is empty
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional model overrides (defaults shown)
# TOOL_MODEL=openai/gpt-4o-mini
# FAST_MODEL=meta-llama/llama-3.1-8b-instruct
## RUBICS_MODEL=
TEMPERATURE=0.0
# MAX_TOKENS=900

# Optional local paths (relative paths are resolved from the repository root)
DATA_DIR=./data
DOCUMENT_PATH=./data
# DOCS_DIR=./docs
# EVAL_RESULTS_DIR=./evalkit/results

# Optional overrides of socratic_tutor/config.py (defaults shown)
# SUPERVISOR_MODEL=openai/gpt-4.1-mini
# SPECIALIST_MODEL=openai/gpt-4o-mini
# JUDGE_MODEL=google/gemini-2.5-flash
# EMBEDDING_MODEL=baai/bge-m3
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# AGENT_TEMPERATURE=0.2
# JUDGE_TEMPERATURE=0.0
# SIMULATED_STUDENT_TEMPERATURE=0.7
# MAX_LLM_CALLS_PER_TURN=12
# MAX_SESSION_TURNS=6
# CASE_TIMEOUT_SECONDS=180

# Local app server (python -m socratic_tutor.app)
# HOST=127.0.0.1
# PORT=8000

# Approval gate (R4): the server-only key that signs the teacher's decisions. A secret: set your own,
# one per machine, never commit it. Create one with: python -c "import secrets; print(secrets.token_hex(32))"
# Empty = the gate refuses every approval (fail closed). Docker gets it through env_file.
APPROVAL_SIGNING_KEY=

# Optional retrieval configuration (dense / hybrid / hybrid_rerank)
# RETRIEVAL_MODE=dense
# TOP_K=4
# CANDIDATE_K=8

# Optional policy & runtime controls
# AGENT_REFUND_LIMIT_INR=5000
# MAX_TOOL_STEPS=6
# LLM_CACHE=true

# Web app and operations (R6)
TEACHER_PIN=1234            # change before any demo; the teacher view needs it
# OPS_DEMO=1                # enables the synthetic leak button used to demo the AnswerLeakSpike alert
# LANGSMITH_TRACING=true    # optional: also send traces to LangSmith (scrubbed traces are always in .cache/traces/)
# LANGSMITH_API_KEY=

# Evaluation (R5): model IDs and budgets are in socratic_tutor/config.py; these override one value
# SIMULATED_STUDENT_MODEL=meta-llama/llama-3.3-70b-instruct
# EVAL_STUB=1               # run the eval harness with the offline stand-in (plumbing check only)
