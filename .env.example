# OpenRouter API Key (required for LLM calls)
# Get your key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Model IDs, sampling and budgets live in config/models.yaml (one versioned
# config). An UPPER_CASE variable with the same name overrides one value, e.g.
# SPECIALIST_MODEL=openai/gpt-4.1-mini

# Optional local paths (relative paths are resolved from the repository root)
DATA_DIR=./data
DOCUMENT_PATH=./data/ncert   # NCERT PDFs (git-ignored; run: python scripts/fetch_ncert.py)

# Optional retrieval configuration (dense / hybrid / hybrid_rerank)
# RETRIEVAL_MODE=dense
# TOP_K=4
# CANDIDATE_K=8

# Web app (R6)
TEACHER_PIN=1234            # change before any demo; the teacher view needs it
# OPS_DEMO=1                # enables the synthetic leak button used to demo the alert

# Optional tracing to LangSmith (traces are always written locally, scrubbed, to results/traces/)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=socratic-tutor

# Experiment switches (the eval harness sets these per config; the app runs with all on)
# SOCRATIC_DEFENCES=on
# SOCRATIC_MEMORY=on
# SOCRATIC_PLAYBOOK=on
