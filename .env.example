# ==============================================================================
# Socratic Tutor Environment Configuration
# ==============================================================================
# Copy this file to .env and configure the values for your environment.
# All settings are loaded centrally through socratic_tutor/config.py.
# ==============================================================================

# --- LLM API Credentials ---
# OpenRouter API Key (required for LLM calls). Get your key at: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-v1-...
# OpenAI API Key (fallback used only when OPENROUTER_API_KEY is unset)
# OPENAI_API_KEY=
# OpenRouter API Base URL (OpenAI-compatible)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Server & Application Configuration ---
# Local server binding for python -m socratic_tutor.app
# HOST=127.0.0.1
# PORT=8000
# CONFIG_VERSION=0.2.0
# Application environment mode: 'development' (default) or 'production'
# MODE=development

# --- Directory Paths ---
# Relative paths resolve against repository root
DATA_DIR=./data
DOCUMENT_PATH=./data
# DOCS_DIR=./docs
# INDEX_DIR=./.index
# CACHE_DIR=./.cache
# EVAL_RESULTS_DIR=./evalkit/results

# --- Model Definitions ---
# SUPERVISOR_MODEL=openai/gpt-4.1-mini
# SPECIALIST_MODEL=openai/gpt-4o-mini
# INTENT_MODEL=openai/gpt-4o-mini
# JUDGE_MODEL=google/gemini-2.5-flash
# GUARD_MODEL=meta-llama/llama-guard-4-12b
# GUARD_MODELS=on                          # 'on' in production, 'off' in offline tests
# EMBEDDING_MODEL=baai/bge-m3
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# SIMULATED_STUDENT_MODEL=meta-llama/llama-3.3-70b-instruct

# --- Model Hyperparameters ---
# LLM_MAX_TOKENS=1500                    # longest reply per model call (OpenRouter reserves credit for it)
# AGENT_TEMPERATURE=0.2
# JUDGE_TEMPERATURE=0.0
# SIMULATED_STUDENT_TEMPERATURE=0.7
# TEMPERATURE=0.0

# --- Graph & Tool Execution Budgets ---
# MAX_LLM_CALLS_PER_TURN=12               # Graph recursion budget per student turn
# GRAPH_RECURSION_LIMIT=29                # LangGraph recursion limit (default: 2 * MAX_LLM_CALLS_PER_TURN + 5)
# MAX_TOOL_CALLS_PER_TURN=20              # Max tool calls allowed per student turn across all agents
# MAX_IDENTICAL_TOOL_CALLS=2             # Max times the exact same tool + args may run in one turn
# MAX_SESSION_TURNS=6                    # Max simulated student turns in an evaluation session
# CASE_TIMEOUT_SECONDS=180                # Timeout per evaluation case

# --- Teacher View & Authentication ---
TEACHER_PIN=1234                         # Teacher portal PIN (change before demo/deployment)
# TEACHER_SECRET=                         # Optional explicit HMAC signing secret for teacher auth
# APPROVAL_SIGNING_KEY=                   # Server-only secret key signing teacher approvals (fail-closed if empty)
                                         # Generate with: python -c "import secrets; print(secrets.token_hex(32))"

# --- Operations & Evaluation Controls ---
# OPS_DEMO=0                             # Set to 1 to enable synthetic answer leak button for ops testing
# EVAL_STUB=0                            # Set to 1 to use offline mock LLM client for testing plumbing
# LANGSMITH_TRACING=false                # Set to true to mirror traces to LangSmith
# LANGSMITH_API_KEY=
