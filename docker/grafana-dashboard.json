{
  "uid": "socratic-tutor",
  "title": "Socratic Tutor",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "socratic"
  ],
  "panels": [
    {
      "id": 15,
      "type": "stat",
      "title": "AnswerLeakSpike alert",
      "description": "More than 2 answer leaks in 10 minutes, held for 1 minute (the working alert). Pending = condition met, waiting 1 minute; Firing = sent.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(max(ALERTS{alertname=\"AnswerLeakSpike\",alertstate=\"firing\"}) * 2) or max(ALERTS{alertname=\"AnswerLeakSpike\",alertstate=\"pending\"}) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OK: no leak spike",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "PENDING",
                  "color": "orange",
                  "index": 1
                },
                "2": {
                  "text": "FIRING: answer-leak spike",
                  "color": "red",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "type": "stat",
      "title": "Answer leaks (24h)",
      "description": "Practice replies flagged by the output guardrail. Synthetic demo leaks excluded.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(socratic_answer_leaks_total{source=\"live\"}[24h]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "id": 1
    },
